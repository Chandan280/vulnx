# Local default: loopback. Export variables in the shell; no automatic dotenv loading.
VULNX_PORT=8787
# Hosted settings (actual domains required; no wildcard origins):
# VULNX_BIND=0.0.0.0
# VULNX_PUBLIC_ORIGIN=https://YOUR-FRONTEND.vercel.app
# VULNX_ALLOWED_HOSTS=YOUR-BACKEND.up.railway.app
# VULNX_ALLOWED_TARGETS=https://YOUR-AUTHORIZED-TARGET:443/,YOUR-MAIL-DOMAIN
# VULNX_JWT_SECRET=<random secret of at least 32 characters>
# VULNX_DATA_DIR=/data
# VULNX_REQUIRE_PERSISTENT_STORAGE=1
# Railway sets RAILWAY_VOLUME_MOUNT_PATH when an actual volume is attached.
# Vercel environment only:
# VULNX_API_ORIGIN=https://YOUR-BACKEND.up.railway.app
